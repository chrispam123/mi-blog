---
// BaseLayout.astro
// Este es el componente raíz que envuelve TODAS las páginas del blog.
// Recibe como props el título y la descripción de cada página
// para que cada post pueda tener sus propios meta tags.
interface Props {
  title: string
  description?: string
}

const { title, description = 'Autopoiesis — codigo y pensamientos' } =
  Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Autopoiesis</title>
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/brand/favicon-32.png"
      sizes="32x32"
      type="image/png"
    />
    <link
      rel="icon"
      href="/brand/favicon-16.png"
      sizes="16x16"
      type="image/png"
    />
    <link rel="shortcut icon" href="/brand/favicon.ico" />

    <!-- Google Fonts: PT Serif para títulos y cuerpo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="side-art side-art-left" aria-hidden="true">
      <img src="/images/layout/caras11-transparent.png" alt="" />
    </div>
    <div class="side-art side-art-right" aria-hidden="true">
      <img src="/images/layout/caras11-transparent.png" alt="" />
    </div>
    <div class="site-wrapper">
      <header class="site-header">
        <img
          src="/brand/favicon.svg"
          alt=""
          class="site-mark"
          aria-hidden="true"
        />
        <a href="/" class="site-title">Autopoiesis</a>
        <span class="site-tagline">notas y pensamientos</span>
      </header>

      <main class="site-main">
        <!-- Aquí se inyecta el contenido de cada página -->
        <slot />
      </main>

      <footer class="site-footer">
        <span>Escrito a mano, desplegado con intención.</span>
      </footer>
    </div>
  </body>
</html>

<script is:inline>
  ;(() => {
    const sideArtImages = document.querySelectorAll('.side-art img')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const desktopLayout = window.matchMedia('(min-width: 1101px)')
    let animationFrame = 0

    if (reducedMotion.matches || !desktopLayout.matches) return

    const updateSideArt = () => {
      animationFrame = 0
      const scrollPosition =
        window.scrollY || document.documentElement.scrollTop
      const offset = scrollPosition * -0.12

      sideArtImages.forEach((image) => {
        image.style.transform = `translateY(${offset}px)`
      })
    }

    const scheduleUpdate = () => {
      if (!animationFrame) {
        animationFrame = window.requestAnimationFrame(updateSideArt)
      }
    }

    window.addEventListener('scroll', scheduleUpdate, {
      passive: true,
      capture: true,
    })
    updateSideArt()
  })()
</script>

<style is:global>
  /* ============================================================
     VARIABLES: el sistema de diseño completo en un solo lugar.
     Cambiar un valor aquí afecta a todo el blog.
  ============================================================ */
  :root {
    --color-bg: #f7f3ed; /* crema cálido, como papel envejecido */
    --color-text: #1a1612;
    --color-muted: #1a1612;
    --color-accent: #899a84;
    --color-border: #e0d8ce; /* líneas sutiles */

    --font-display: 'PT Serif', Georgia, serif;
    --font-body: 'PT Serif', Georgia, serif;

    --max-width: 680px; /* ancho máximo del contenido */
    --spacing-unit: 1rem;
  }

  /* Reset mínimo y base */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 20px; /* base generosa para lectura cómoda */
  }

  body {
    position: relative;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.7;
    /* Suavizado de fuentes para que las serif se vean bien en pantalla */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Contenedor principal centrado */
  .site-wrapper {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-unit);
  }

  /* Header: nombre del blog arriba, espacioso */
  .site-header {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .site-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-mark {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    margin-bottom: 0.5rem;
  }

  .side-art {
    position: fixed;
    top: 0;
    height: 100vh;
    width: min(360px, calc((100vw - var(--max-width)) / 2 - 2rem));
    overflow: hidden;
    pointer-events: none;
    opacity: 0.18;
    z-index: 0;
  }

  .side-art img {
    position: absolute;
    top: 0;
    width: 210%;
    max-width: none;
    height: auto;
    will-change: transform;
  }

  .side-art-left {
    left: 0;
  }

  .side-art-left img {
    left: 0;
  }

  .side-art-right {
    right: 0;
  }

  .side-art-right img {
    left: -110%;
  }

  @media (max-width: 1100px) {
    .side-art {
      display: none;
    }
  }

  .site-title:hover {
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .site-tagline {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Footer: discreto, al fondo */
  .site-footer {
    margin-top: 6rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Tipografía general para el contenido de los posts */
  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
  }

  a {
    color: inherit;
  }
</style>
