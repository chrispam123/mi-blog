---
// BaseLayout.astro
// Este es el componente raíz que envuelve TODAS las páginas del blog.
// Recibe como props el título y la descripción de cada página
// para que cada post pueda tener sus propios meta tags.
interface Props {
  title: string
  description?: string
}

const { title, description = 'Autopoiesis — codigo y pensamientos' } =
  Astro.props
const isHome = Astro.url.pathname === '/'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Autopoiesis</title>
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/brand/favicon-32.png"
      sizes="32x32"
      type="image/png"
    />
    <link
      rel="icon"
      href="/brand/favicon-16.png"
      sizes="16x16"
      type="image/png"
    />
    <link rel="shortcut icon" href="/brand/favicon.ico" />

    <!-- Google Fonts: PT Serif para títulos y cuerpo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class={isHome ? 'home-page' : ''}>
    <div class="side-art side-art-left" aria-hidden="true">
      <div class="side-art-track">
        <img src="/images/layout/caras11-transparent.png" alt="" />
        <img src="/images/layout/caras11-transparent.png" alt="" />
      </div>
    </div>
    <div class="side-art side-art-right" aria-hidden="true">
      <div class="side-art-track">
        <img src="/images/layout/caras11-transparent.png" alt="" />
        <img src="/images/layout/caras11-transparent.png" alt="" />
      </div>
    </div>
    <div class="site-wrapper">
      <header
        class={isHome ? 'site-header' : 'site-header site-header-compact'}
      >
        {
          isHome ? (
            <>
              <img
                src="/brand/favicon.svg"
                alt=""
                class="site-mark"
                aria-hidden="true"
              />
              <a href="/" class="site-title">
                Autopoiesis
              </a>
              <h3 class="site-intro-title">
                Sistemas complejos, superficies silenciosas.
              </h3>
              <p class="site-intro-copy">
                Notas de ingeniería, arquitectura cloud y ensayos visuales sobre
                cómo diseño y despliego software en el mundo real: con
                decisiones propias, margen para el error y cero dogmas. La IA
                acelera la ejecución; el criterio, las palabras y la
                arquitectura siguen siendo artesanales.
              </p>
              <p class="site-manifesto">
                <span>Manifiesto:</span> Escrito a mano, desplegado con
                intención.
              </p>
            </>
          ) : (
            <a href="/" class="site-mark-link" aria-label="Volver al inicio">
              <img
                src="/brand/favicon.svg"
                alt=""
                class="site-mark"
                aria-hidden="true"
              />
            </a>
          )
        }
      </header>

      <main class="site-main">
        <!-- Aquí se inyecta el contenido de cada página -->
        <slot />
      </main>

      <footer class="site-footer">
        <nav class="footer-links" aria-label="Enlaces externos">
          <a
            class="footer-link"
            href="https://d2134ixdakjhb7.cloudfront.net/index.html"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir proyecto del ojo"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
              ></path>
              <circle cx="12" cy="12" r="2.75"></circle>
            </svg>
            <span>Portfolio</span>
          </a>
          <a
            class="footer-link"
            href="https://dgavxo1zmkai7.cloudfront.net/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir lienzo"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="4" y="4" width="16" height="16" rx="1.5"></rect>
              <path d="M8 8h8M8 12h8M8 16h5"></path>
            </svg>
            <span>Lienzo</span>
          </a>
          <a
            class="footer-link"
            href="https://github.com/chrispam123"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir GitHub de Christian Gohring"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M12 2.5a9.5 9.5 0 0 0-3 18.51c.48.09.66-.21.66-.47v-1.84c-2.7.59-3.27-1.14-3.27-1.14-.44-1.12-1.08-1.42-1.08-1.42-.88-.6.07-.59.07-.59.97.07 1.48 1 1.48 1 .87 1.48 2.28 1.05 2.84.8.09-.62.34-1.05.62-1.29-2.16-.25-4.43-1.08-4.43-4.81 0-1.06.38-1.92 1-2.6-.1-.25-.43-1.23.1-2.57 0 0 .82-.26 2.67.99A9.3 9.3 0 0 1 12 6.74c.82 0 1.65.11 2.42.33 1.84-1.25 2.66-.99 2.66-.99.53 1.34.2 2.32.1 2.57.62.68 1 1.54 1 2.6 0 3.74-2.27 4.56-4.44 4.8.35.31.66.92.66 1.86v2.76c0 .26.18.56.67.47A9.5 9.5 0 0 0 12 2.5Z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
        </nav>
        <small class="footer-copyright">©2026 Christian Gohring</small>
      </footer>
    </div>
  </body>
</html>

<script is:inline>
  ;(() => {
    const sideArtTracks = document.querySelectorAll('.side-art-track')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const desktopLayout = window.matchMedia('(min-width: 1101px)')
    let animationFrame = 0

    if (reducedMotion.matches || !desktopLayout.matches) return

    const updateSideArt = () => {
      animationFrame = 0
      const scrollPosition =
        window.scrollY || document.documentElement.scrollTop
      const parallaxDistance = scrollPosition * -0.12

      sideArtTracks.forEach((track) => {
        const tile = track.querySelector('img')
        const tileHeight = tile?.getBoundingClientRect().height ?? 0

        if (!tileHeight) return

        const offset = parallaxDistance % tileHeight
        track.style.transform = `translateY(${offset - tileHeight}px)`
      })
    }

    const scheduleUpdate = () => {
      if (!animationFrame) {
        animationFrame = window.requestAnimationFrame(updateSideArt)
      }
    }

    window.addEventListener('scroll', scheduleUpdate, {
      passive: true,
      capture: true,
    })
    window.addEventListener('resize', scheduleUpdate, { passive: true })
    window.addEventListener('load', updateSideArt, { once: true })
    updateSideArt()
  })()
</script>

<style is:global>
  /* ============================================================
     VARIABLES: el sistema de diseño completo en un solo lugar.
     Cambiar un valor aquí afecta a todo el blog.
  ============================================================ */
  :root {
    --color-bg: #f7f3ed; /* crema cálido, como papel envejecido */
    --color-text: #1a1612;
    --color-muted: #1a1612;
    --color-accent: #899a84;
    --color-border: #e0d8ce; /* líneas sutiles */

    --font-display: 'PT Serif', Georgia, serif;
    --font-body: 'PT Serif', Georgia, serif;

    --max-width: 680px; /* ancho máximo del contenido */
    --spacing-unit: 1rem;
  }

  /* La portada usa un lienzo algo más ancho; el arte lateral se adapta a --max-width. */
  .home-page {
    --max-width: 820px;
  }

  /* Reset mínimo y base */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 20px; /* base generosa para lectura cómoda */
  }

  body {
    position: relative;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.7;
    /* Suavizado de fuentes para que las serif se vean bien en pantalla */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Contenedor principal centrado */
  .site-wrapper {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-unit);
  }

  /* Header: nombre del blog arriba, espacioso */
  .site-header {
    padding: 4rem 0 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .site-header-compact {
    padding: 1.5rem 0 0.75rem;
    margin-bottom: 0.75rem;
  }

  .site-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-mark {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    margin-bottom: 0.5rem;
  }

  .site-mark-link {
    display: inline-flex;
    width: fit-content;
  }

  .site-header-compact .site-mark {
    margin-bottom: 0;
  }

  .side-art {
    position: fixed;
    top: 0;
    height: 100vh;
    width: min(360px, calc((100vw - var(--max-width)) / 2 - 2rem));
    overflow: hidden;
    pointer-events: none;
    opacity: 0.18;
    z-index: 0;
  }

  .side-art-track {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  .side-art-left {
    left: 0;
  }

  .side-art-left img {
    position: relative;
    left: 0;
  }

  .side-art-right {
    right: 0;
  }

  .side-art-right img {
    position: relative;
    left: -110%;
  }

  .side-art img {
    display: block;
    width: 210%;
    max-width: none;
    height: auto;
  }

  @media (max-width: 1100px) {
    .side-art {
      display: none;
    }
  }

  .site-title:hover {
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .site-intro-title {
    max-width: 18ch;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
    color: var(--color-accent);
  }

  .site-intro-copy {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: #68645f;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .site-manifesto {
    max-width: 58ch;
    margin-top: 1.25rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-border);
    color: var(--color-muted);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .site-manifesto span {
    color: var(--color-accent);
  }

  /* Footer: discreto, al fondo */
  .site-footer {
    margin-top: 6rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    font-size: 0.7rem;
    text-decoration: none;
  }

  .footer-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .footer-link:nth-child(3) svg {
    fill: currentColor;
    stroke: none;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-copyright {
    display: block;
    margin-top: 1rem;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  /* Tipografía general para el contenido de los posts */
  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
  }

  a {
    color: inherit;
  }
</style>
