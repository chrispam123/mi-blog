    margin-top: 10px;
  }
  #aetherAppMapContainer .legend {
    margin-top: 14px;
    padding: 12px 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    color: #a8bbcb;
    font-size: 0.76rem;
  }
  #aetherAppMapContainer .key {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  #aetherAppMapContainer .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  #aetherAppMapContainer .journey {
    margin-top: 14px;
    padding: 16px;
  }
  #aetherAppMapContainer .journeyhead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  #aetherAppMapContainer .journey h3 {
    font-size: 1rem;
    margin: 0;
    color: #edf5fb;
  }
  #aetherAppMapContainer .journey p {
    color: #a8bbcb;
    margin: 4px 0 0;
    font-size: 0.82rem;
  }
  #aetherAppMapContainer .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 14px;
  }
  #aetherAppMapContainer .step {
    border: 1px solid #2b4055;
    border-radius: 10px;
    background: #0e1a27;
    padding: 10px;
    min-height: 82px;
    cursor: pointer;
    text-align: left;
    opacity: 0.55;
    transition: 0.2s;
  }
  #aetherAppMapContainer .step b {
    font-size: 0.78rem;
    display: block;
    color: #edf5fb;
  }
  #aetherAppMapContainer .step small {
    font-size: 0.7rem;
    color: #a8bbcb;
  }
  #aetherAppMapContainer .step.done {
    opacity: 1;
    border-color: #3f8a77;
  }
  #aetherAppMapContainer .step.current {
    opacity: 1;
    border-color: #65d9ec;
    box-shadow: 0 0 0 2px #65d9ec25;
  }
  #aetherAppMapContainer .progress {
    height: 5px;
    border-radius: 8px;
    background: #203448;
    margin-top: 12px;
    overflow: hidden;
  }
  #aetherAppMapContainer .progress i {
    height: 100%;
    width: 0;
    display: block;
    background: linear-gradient(90deg, #65d9ec, #b6a0ff);
    transition: width 0.35s;
  }
  #aetherAppMapContainer .foot {
    color: #8ea2b3;
    font-size: 0.75rem;
    margin: 14px 3px 0;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  #aetherAppMapContainer .only {
    display: none;
  }
  #aetherAppMapContainer .only.show {
    display: block;
  }
  #aetherAppMapContainer .node.selected {
    outline: 2px solid #65d9ec;
    outline-offset: 2px;
  }
  @media (max-width: 1050px) {
    #aetherAppMapContainer .layout {
      grid-template-columns: 1fr;
    }
    #aetherAppMapContainer .detail {
      position: static;
    }
    #aetherAppMapContainer .top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 650px) {
    #aetherAppMapContainer .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    #aetherAppMapContainer .control {
      margin-left: 0;
    }
