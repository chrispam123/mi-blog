    margin: 11px auto 0;
    max-width: 740px;
    border-top: 1px dashed #40576d;
    padding-top: 11px;
  }
  #aetherAppMapContainer .branch {
    border-left: 2px dashed #4b7181;
    margin: 8px 0 0 24px;
    padding: 3px 0 3px 16px;
    color: #d1e0ea;
    font-size: 0.8rem;
  }
  #aetherAppMapContainer .branch span {
    color: #a8bbcb;
  }
  #aetherAppMapContainer .eventline {
