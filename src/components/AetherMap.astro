      renderJourney()
      byId('detailAppMap').innerHTML =
        '<div class="kind">Explora el diagrama</div><h3>Selecciona un componente</h3><p>Haz clic sobre los bloques del mapa para ver qué responsabilidad tienen y qué información reciben o envían.</p><div class="fact"><b>Cómo leer las flechas</b><span>Las flechas indican dirección de la llamada o de los datos. El texto sobre cada flecha describe el tipo de operación.</span></div><div class="hint">Este mapa refleja el comportamiento del código revisado: el flujo está funcionando actualmente.</div>'
    }
    byId<HTMLButtonElement>('playAppMap').onclick = function () {
      if (playTimer) {
        clearInterval(playTimer)
        playTimer = null
        byId('playAppMap').textContent = '▶ Recorrer flujo'
        return
      }
      var j = appJourneys[currentView]
      if (currentStep >= j.steps.length - 1) currentStep = -1
      byId('playAppMap').textContent = '⏸ Pausar'
      playTimer = setInterval(function () {
        if (currentStep >= j.steps.length - 1) {
          if (playTimer !== null) clearInterval(playTimer)
          playTimer = null
          byId('playAppMap').textContent = '▶ Recorrer flujo'
          return
        }
        goStep(currentStep + 1)
      }, 1700)
    }
    renderJourney()
  })()
</script>
