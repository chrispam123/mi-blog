  #aetherAppMapContainer .top h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin: 8px 0 10px;
    color: #ffffff;
  }
  #aetherAppMapContainer .lead {
    color: #a8bbcb;
    max-width: 820px;
    margin: 0;
    font-size: 0.95rem;
  }
  #aetherAppMapContainer .stamp {
    border: 1px solid #31506a;
    border-radius: 14px;
    padding: 10px 14px;
    color: #d3e5f3;
    background: #101e2c;
    white-space: nowrap;
    font-size: 0.82rem;
  }
  #aetherAppMapContainer .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px 0 16px;
    border-top: 1px solid #1e3246;
  }
  #aetherAppMapContainer .tab,
  #aetherAppMapContainer .control {
    border: 1px solid #294158;
    background: #122131;
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
    transition: 0.18s;
    font-size: 0.85rem;
  }
  #aetherAppMapContainer .tab:hover,
  #aetherAppMapContainer .control:hover {
    border-color: #65d9ec;
    transform: translateY(-1px);
  }
  #aetherAppMapContainer .tab[aria-selected='true'] {
    background: #173749;
    border-color: #65d9ec;
    color: #eaffff;
    box-shadow: 0 0 0 2px #65d9ec1a;
  }
  #aetherAppMapContainer .control {
    margin-left: auto;
  }
  #aetherAppMapContainer .control.secondary {
    margin-left: 0;
  }
  #aetherAppMapContainer .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 18px;
    align-items: start;
  }
  #aetherAppMapContainer .mapwrap,
  #aetherAppMapContainer .detail,
  #aetherAppMapContainer .legend,
  #aetherAppMapContainer .journey {
    border: 1px solid #25394d;
    border-radius: 18px;
    background: linear-gradient(160deg, #111f2e, #0c1723);
  }
