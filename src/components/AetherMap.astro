    margin: 0 0 14px;
    font-size: 0.88rem;
  }
  #aetherAppMapContainer .detail .kind {
    color: #65d9ec;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-weight: 800;
  }
  #aetherAppMapContainer .fact {
    border-top: 1px solid #25394d;
    padding: 10px 0;
  }
  #aetherAppMapContainer .fact b {
    display: block;
    font-size: 0.75rem;
    color: #94cce0;
    margin-bottom: 3px;
  }
  #aetherAppMapContainer .fact span {
    font-size: 0.82rem;
    color: #d4e1e9;
