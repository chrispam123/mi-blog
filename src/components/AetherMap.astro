    font-size: 0.95rem;
  }
  #aetherAppMapContainer .maphead span {
    color: #a8bbcb;
    font-size: 0.8rem;
  }
  #aetherAppMapContainer .canvas {
    padding: 14px;
    overflow-x: auto;
  }
  #aetherAppMapContainer .flow {
    min-width: 820px;
    position: relative;
    padding: 4px 0 12px;
  }
  #aetherAppMapContainer .zone {
    border: 1px solid #345068;
    border-radius: 16px;
    background: #0c1926e8;
    margin: 0 0 14px;
    padding: 13px 14px 15px;
    position: relative;
  }
  #aetherAppMapContainer .zone.client {
    border-color: #2b8191;
  }
  #aetherAppMapContainer .zone.aws {
    border-color: #a9672c;
    background: linear-gradient(120deg, #171c29, #101a26);
  }
  #aetherAppMapContainer .zone.data {
    border-color: #395f86;
  }
  #aetherAppMapContainer .zonehead {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    font-size: 0.95rem;
    color: #ffffff;
  }
  #aetherAppMapContainer .zonehead .tag {
    margin-left: auto;
    font-size: 0.72rem;
    color: #a8bbcb;
    font-weight: 600;
  }
  #aetherAppMapContainer .row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    min-height: 84px;
  }
  #aetherAppMapContainer .node {
    flex: 1;
    min-width: 115px;
    max-width: 240px;
    align-self: stretch;
    text-align: left;
    border: 1px solid #344e65;
    border-radius: 12px;
    padding: 10px 12px;
    background: linear-gradient(145deg, #172a3d, #112131);
    cursor: pointer;
    position: relative;
    transition: 0.18s;
  }
  #aetherAppMapContainer .node:hover,
  #aetherAppMapContainer .node.active {
    border-color: #65d9ec;
    transform: translateY(-2px);
    box-shadow: 0 0 0 2px #65d9ec25;
  }
  #aetherAppMapContainer .node .icon {
    display: block;
    font-size: 1.2rem;
    margin-bottom: 3px;
  }
  #aetherAppMapContainer .node b {
    display: block;
    font-size: 0.88rem;
    line-height: 1.22;
    color: #edf5fb;
  }
  #aetherAppMapContainer .node small {
    display: block;
    color: #a8bbcb;
    font-size: 0.73rem;
    line-height: 1.32;
    margin-top: 4px;
  }
  #aetherAppMapContainer .arrow {
    align-self: center;
    flex: 0 0 72px;
    text-align: center;
    color: #65d9ec;
    font-size: 0.7rem;
    line-height: 1.22;
    position: relative;
    padding-top: 18px;
  }
  #aetherAppMapContainer .arrow:before {
    content: '';
    position: absolute;
    left: 4px;
    right: 12px;
    top: 8px;
    height: 2px;
    background: linear-gradient(90deg, #41778a, #65d9ec);
  }
  #aetherAppMapContainer .arrow:after {
    content: '';
    position: absolute;
    right: 5px;
    top: 3px;
    width: 9px;
    height: 9px;
    border-top: 2px solid #65d9ec;
    border-right: 2px solid #65d9ec;
    transform: rotate(45deg);
  }
  #aetherAppMapContainer .arrow.purple {
    color: #b6a0ff;
  }
  #aetherAppMapContainer .arrow.purple:before {
    background: linear-gradient(90deg, #675c9a, #b6a0ff);
  }
  #aetherAppMapContainer .arrow.purple:after {
    border-color: #b6a0ff;
  }
  #aetherAppMapContainer .arrow.orange {
    color: #ffad57;
  }
  #aetherAppMapContainer .arrow.orange:before {
    background: linear-gradient(90deg, #8e603c, #ffad57);
  }
  #aetherAppMapContainer .arrow.orange:after {
    border-color: #ffad57;
  }
  #aetherAppMapContainer .arrow.green {
    color: #75dda5;
  }
  #aetherAppMapContainer .arrow.green:before {
    background: linear-gradient(90deg, #367957, #75dda5);
  }
  #aetherAppMapContainer .arrow.green:after {
    border-color: #75dda5;
  }
