---
// index.astro
// Ahora los posts se leen automáticamente desde src/content/posts/
// getCollection() es la función de Astro que lee todos los archivos
// Markdown de una colección y devuelve un array con sus datos.
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

// Obtenemos todos los posts y los ordenamos por fecha descendente
// para que el más reciente aparezca siempre primero.
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
---

<BaseLayout title="Inicio">
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <div class="post-copy">
            <time class="post-date">
              {post.data.date.toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <a href={`/posts/${post.id}`} class="post-title">
              {post.data.title}
            </a>
            {post.data.description && (
              <p class="post-description">{post.data.description}</p>
            )}
          </div>
          {post.data.image && (
            <a
              href={`/posts/${post.id}`}
              class="post-image-link"
              aria-label={`Leer ${post.data.title}`}
            >
              <img
                src={post.data.image}
                alt={post.data.title}
                class="post-image"
                style={`object-position: ${post.data.imagePosition ?? 'center center'}`}
                loading="lazy"
              />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .post-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 160px;
    gap: 2rem;
    align-items: center;
  }

  .post-copy {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .post-date {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    color: var(--color-accent);
  }

  .post-title:hover {
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .post-description {
    font-size: 17px;
    font-weight: 400;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .post-image-link {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-border);
  }

  .post-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .post-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .post-image-link {
      width: min(100%, 240px);
    }
  }
</style>
